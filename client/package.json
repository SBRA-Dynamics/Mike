{
  "name": "jarvis-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Jarvis client \u2014 Even Hub plugin: lens view + companion view (PRD 4)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node -e \"require('fs').copyFileSync('app.json','../public/app.json')\"",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json ../public -o ../jarvis.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.15",
    "@evenrealities/pretext": "^0.1.4"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
