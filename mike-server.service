[Unit]
# PRD 1 R1.8. Install:
#   sudo cp ~/mike/mike-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now mike-server
Description=Mike server (transport, sessions, client hosting)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=robin
Group=robin
WorkingDirectory=/home/robin/mike
# systemd starts with a bare PATH. node lives under nvm, and later phases spawn
# claude from ~/.local/bin; both have to be spelled out.
Environment=PATH=/home/robin/.nvm/versions/node/v24.16.0/bin:/home/robin/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/robin
# Token from a root-only file: never on the command line, where ps exposes it
# to every user on the machine.
EnvironmentFile=/etc/mike.env
# PRD 2's MCP tool surface binds its own listener on 127.0.0.1 with an
# ephemeral port. Nothing outside the process needs to find it — each Claude
# Code invocation is handed the URL in its grant — so no port is opened for it.
# PRD 3 drives a real `claude` per turn. The defaults are opus for Mike,
# sonnet for a worker, and this WorkingDirectory for both; add
#   --worker-cwd /home/user/projects --mike-cwd /home/user/projects
# to start workers somewhere worth working. `--engine stub` keeps the whole
# thing alive without spending money, which is the safe way to run it while
# something else is being debugged.
# Public deployment: the router forwards external 3456 to internal 3455, and the
# certificate is the one certbot keeps for mike.example.com (readable by robin
# through an ACL, so this does not run as root). The phone therefore reaches
#   https://mike.example.com:3456/
#
# --worker-perms full is a deliberate choice and the riskiest line in this file:
# a worker turn then runs with the same power as the user, and this listener is
# reachable from the internet behind one bearer token. That token IS the ability
# to run code on this machine. Narrow it to `edits` or `readonly` the moment
# that stops being what is wanted.
ExecStart=/home/robin/.nvm/versions/node/v24.16.0/bin/node /home/robin/mike/server.js \
  --port 3455 --host 0.0.0.0 \
  --cert /etc/letsencrypt/live/mike.example.com/fullchain.pem \
  --key /etc/letsencrypt/live/mike.example.com/privkey.pem \
  --worker-cwd /home/user/projects --mike-cwd /home/user/projects \
  --worker-perms full
Restart=always
# The server reaps its own `claude` children on SIGTERM; this is the backstop
# for the case where it cannot, because a turn in flight is a model session
# that keeps spending after the thing that was reading it has gone.
KillMode=control-group
TimeoutStopSec=15
RestartSec=5
# A real file, never an inherited tty. A previous server wrote 69 GB of one
# stacktrace after its terminal closed, because every console.log then threw
# EIO into an uncaught handler and requests silently stopped completing.
StandardOutput=append:/home/robin/mike-server.log
StandardError=append:/home/robin/mike-server.log

[Install]
WantedBy=multi-user.target
